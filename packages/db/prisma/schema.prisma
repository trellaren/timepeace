// Timepeace data model. See docs/data-model.md.
// Conventions: money = Int cents; rates/percent = Int basis points; instants = UTC timestamptz;
// calendar dates = @db.Date interpreted in the organization's timezone.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  OWNER
  MANAGER
  WORKER
  HR
  ACCOUNTANT
}

enum WorkerClassification {
  W2
  CONTRACTOR_1099
}

enum PayPeriodType {
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
}

enum EntityType {
  SOLE_PROP
  LLC_SINGLE
  PARTNERSHIP
  S_CORP
  C_CORP
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETE
  CANCELLED
}

enum ContractType {
  FIXED
  COST_PLUS
  T_AND_M
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  NEEDS_MATERIALS
  BLOCKED
  DONE
  VERIFIED
}

enum CostCategory {
  LABOR
  MATERIAL
  SUB
  EQUIPMENT
  OTHER
}

enum ChangeOrderStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  VOID
}

enum TimeEntrySource {
  TIMER
  MANUAL
}

enum ShiftFlag {
  /// No clock-out was recorded; closed automatically at the last known activity. Needs manager review.
  AUTO_CLOSED
  /// Edited by a manager (see AuditLog).
  EDITED
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  EXPORTED
  PAID
}

enum ExpenseStatus {
  SUBMITTED
  APPROVED
  REJECTED
  REIMBURSED
}

enum PaidBy {
  COMPANY
  PERSONAL
}

enum MaterialRequestStatus {
  REQUESTED
  ORDERED
  DELIVERED
  CANCELLED
}

enum CommentKind {
  NOTE
  QUESTION
}

enum FileKind {
  RECEIPT
  PHOTO
  THUMBNAIL
}

enum ChecklistResult {
  PASS
  FAIL
  NA
}

/// W-9 line 3 federal tax classification.
enum VendorTaxClass {
  INDIVIDUAL
  PARTNERSHIP
  C_CORP
  S_CORP
  LLC_C
  LLC_S
  LLC_P
  TRUST_ESTATE
  OTHER
}

/// How a vendor was paid. CARD (credit/debit/third-party network) payments are reported on 1099-K by the processor, not on your 1099-NEC.
enum PaymentMethod {
  CHECK
  ACH
  CASH
  CARD
}

enum PayrollExportFormat {
  GENERIC_CSV
  PDF
  GUSTO_CSV
  ADP_CSV
  QBO_CSV
}

// ───────────────────── Organization & people ─────────────────────

model Organization {
  id               String        @id @default(cuid())
  name             String
  timezone         String        @default("America/Denver")
  entityType       EntityType    @default(LLC_SINGLE)
  payPeriodType    PayPeriodType @default(WEEKLY)
  /// Start date of any real pay period (anchors BIWEEKLY periods).
  payPeriodAnchor  DateTime      @db.Date
  weekStartsOn     Int           @default(0)
  /// Overtime rules (see packages/shared/src/overtime.ts OvertimeRules).
  overtimeRules    Json
  /// Default labor burden (payroll tax, workers' comp, benefits) in bps.
  defaultBurdenBps Int           @default(2500)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  memberships          Membership[]
  clients              Client[]
  projects             Project[]
  costCodes            CostCode[]
  templates            ProjectTemplate[]
  vendors              Vendor[]
  payPeriods           PayPeriod[]
  checklistTemplates   ChecklistTemplate[]
  taxYearSettings      TaxYearSettings[]
  estimatedTaxPayments EstimatedTaxPayment[]
  mileageLogs          MileageLog[]
  auditLogs            AuditLog[]
  files                FileObject[]
  taskComments         TaskComment[]
  payrollExports       PayrollExport[]
  invites              Invite[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships      Membership[]
  sessions         Session[]
  workerProfiles   WorkerProfile[]
  assignments      TaskAssignment[]
  timeEntries      TimeEntry[]
  shifts           Shift[]
  timesheets       Timesheet[]       @relation("TimesheetOwner")
  reviewedSheets   Timesheet[]       @relation("TimesheetReviewer")
  expenses         Expense[]         @relation("ExpenseSubmitter")
  reviewedExpenses Expense[]         @relation("ExpenseReviewer")
  materialRequests MaterialRequest[]
  walkthroughs     Walkthrough[]
  dailyLogs        DailyLog[]
  mileageLogs      MileageLog[]
  auditLogs        AuditLog[]
  processedOps     ProcessedOp[]
  invitesSent      Invite[]          @relation("InviteSender")
  invitesAccepted  Invite[]          @relation("InviteAcceptor")
  taskComments     TaskComment[]
  taskCommentReads TaskCommentRead[]
}

model Membership {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  role      Role
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

model Session {
  id         String   @id @default(cuid())
  /// SHA-256 of the bearer token; the raw token is never stored.
  tokenHash  String   @unique
  userId     String
  orgId      String
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkerProfile {
  id             String               @id @default(cuid())
  orgId          String
  userId         String
  classification WorkerClassification @default(W2)
  /// Overrides org default when set.
  burdenBps      Int?
  /// For 1099 contractors: link to the vendor record used for 1099-NEC.
  vendorId       String?
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor         Vendor?              @relation(fields: [vendorId], references: [id])
  payRates       PayRate[]

  @@unique([orgId, userId])
}

/// Effective-dated pay rate history. The rate in effect on a work date is the latest effectiveDate <= that date.
model PayRate {
  id              String        @id @default(cuid())
  workerProfileId String
  hourlyRateCents Int
  effectiveDate   DateTime      @db.Date
  createdAt       DateTime      @default(now())
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@unique([workerProfileId, effectiveDate])
}

// ───────────────────── Projects, tasks, schedule ─────────────────────

model Client {
  id       String       @id @default(cuid())
  orgId    String
  name     String
  email    String?
  phone    String?
  address  String?
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([orgId])
}

model Project {
  id                 String        @id @default(cuid())
  orgId              String
  clientId           String?
  name               String
  code               String?
  /// Free-form type used for cross-project analysis, e.g. "New build", "Remodel", "Addition".
  projectType        String?
  status             ProjectStatus @default(PLANNING)
  contractType       ContractType  @default(FIXED)
  contractValueCents Int           @default(0)
  /// Fee on cost for COST_PLUS / T_AND_M jobs, in bps (1500 = 15%). Revenue = cost × (1 + markup).
  markupBps          Int?
  address            String?
  latitude           Float?
  longitude          Float?
  geofenceRadiusM    Int?
  startDate          DateTime?     @db.Date
  targetEndDate      DateTime?     @db.Date
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client       Client?       @relation(fields: [clientId], references: [id])
  phases       Phase[]
  tasks        Task[]
  budgetLines  BudgetLine[]
  changeOrders ChangeOrder[]
  invoices     Invoice[]
  timeEntries  TimeEntry[]
  shifts       Shift[]
  expenses     Expense[]
  walkthroughs Walkthrough[]
  dailyLogs    DailyLog[]
  mileageLogs  MileageLog[]

  @@index([orgId, status])
}

model Phase {
  id        String  @id @default(cuid())
  projectId String
  name      String
  sortOrder Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId])
}

model Task {
  id                     String     @id @default(cuid())
  projectId              String
  phaseId                String?
  costCodeId             String?
  title                  String
  description            String?
  status                 TaskStatus @default(TODO)
  statusNote             String?
  statusChangedAt        DateTime?
  estimatedMinutes       Int?
  estimatedMaterialCents Int?
  sortOrder              Int        @default(0)
  /// Set when created from a failed walkthrough item (punch list).
  walkthroughItemId      String?    @unique
  completedAt            DateTime?
  completedById          String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase            Phase?                 @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  costCode         CostCode?              @relation(fields: [costCodeId], references: [id])
  walkthroughItem  WalkthroughItemResult? @relation(fields: [walkthroughItemId], references: [id])
  assignments      TaskAssignment[]
  timeEntries      TimeEntry[]
  expenses         Expense[]
  materialRequests MaterialRequest[]
  dependsOn        TaskDependency[]       @relation("DependentTask")
  blocks           TaskDependency[]       @relation("PrerequisiteTask")
  statusEvents     TaskStatusEvent[]
  comments         TaskComment[]
  commentReads     TaskCommentRead[]

  @@index([projectId, status])
}

model TaskDependency {
  taskId          String
  dependsOnTaskId String
  task            Task   @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn       Task   @relation("PrerequisiteTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnTaskId])
}

/// History of status changes; feeds "time waiting on materials" analytics.
model TaskStatusEvent {
  id     String     @id @default(cuid())
  taskId String
  userId String?
  from   TaskStatus
  to     TaskStatus
  note   String?
  at     DateTime
  task   Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, at])
}

model TaskAssignment {
  id             String    @id @default(cuid())
  taskId         String
  userId         String
  scheduledStart DateTime? @db.Date
  scheduledEnd   DateTime? @db.Date
  createdAt      DateTime  @default(now())
  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId, scheduledStart])
}

model ProjectTemplate {
  id          String       @id @default(cuid())
  orgId       String
  name        String
  projectType String?
  /// [{ name, tasks: [{ title, costCode, estimatedMinutes, estimatedMaterialCents }] }]
  phases      Json
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// ───────────────────── Budget & revenue ─────────────────────

model CostCode {
  id          String       @id @default(cuid())
  orgId       String
  code        String
  name        String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tasks       Task[]
  budgetLines BudgetLine[]
  expenses    Expense[]

  @@unique([orgId, code])
}

model BudgetLine {
  id          String       @id @default(cuid())
  projectId   String
  costCodeId  String
  category    CostCategory
  amountCents Int
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCode    CostCode     @relation(fields: [costCodeId], references: [id])

  @@unique([projectId, costCodeId, category])
}

model ChangeOrder {
  id              String            @id @default(cuid())
  projectId       String
  number          Int
  title           String
  description     String?
  amountCents     Int
  /// Added cost budget; split by cost code later if needed.
  costImpactCents Int               @default(0)
  status          ChangeOrderStatus @default(DRAFT)
  approvedAt      DateTime?
  createdAt       DateTime          @default(now())
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
}

model Invoice {
  id          String        @id @default(cuid())
  projectId   String
  number      String
  description String?
  amountCents Int
  issuedOn    DateTime      @db.Date
  dueOn       DateTime?     @db.Date
  status      InvoiceStatus @default(DRAFT)
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payments    Payment[]
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  amountCents Int
  receivedOn  DateTime @db.Date
  method      String?
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// ───────────────────── Field data ─────────────────────

/// Clock in → clock out. Shifts are what workers are PAID for (timesheets, overtime, gross).
/// Task time entries inside a shift only allocate that time to jobs; unallocated shift time is still paid.
model Shift {
  id          String          @id @default(uuid())
  orgId       String
  userId      String
  /// Job site clocked in at, if any. Unallocated shift time is charged here (else company overhead).
  projectId   String?
  timesheetId String?
  clockInAt   DateTime
  clockOutAt  DateTime?
  inLat       Float?
  inLng       Float?
  outLat      Float?
  outLng      Float?
  source      TimeEntrySource @default(TIMER)
  flag        ShiftFlag?
  note        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  project     Project?     @relation(fields: [projectId], references: [id])
  timesheet   Timesheet?   @relation(fields: [timesheetId], references: [id])
  breaks      ShiftBreak[]
  timeEntries TimeEntry[]

  @@index([userId, clockInAt])
  @@index([orgId, clockInAt])
}

/// A recorded meal break. Only breaks >= the org's minimum (default 20 min) are unpaid.
model ShiftBreak {
  id        String    @id @default(uuid())
  shiftId   String
  startedAt DateTime
  endedAt   DateTime?
  shift     Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
}

/// Task time: allocates part of a shift to a task for job costing. Does not determine pay.
model TimeEntry {
  /// Client-generated UUID for entries created on mobile (offline idempotency).
  id           String          @id @default(uuid())
  orgId        String
  userId       String
  shiftId      String?
  projectId    String
  taskId       String?
  timesheetId  String?
  startedAt    DateTime
  endedAt      DateTime?
  breakMinutes Int             @default(0)
  source       TimeEntrySource @default(TIMER)
  startLat     Float?
  startLng     Float?
  endLat       Float?
  endLng       Float?
  note         String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  shift     Shift?     @relation(fields: [shiftId], references: [id])
  project   Project    @relation(fields: [projectId], references: [id])
  task      Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  timesheet Timesheet? @relation(fields: [timesheetId], references: [id])

  @@index([userId, startedAt])
  @@index([projectId, startedAt])
}

model Expense {
  id              String         @id @default(uuid())
  orgId           String
  userId          String
  /// null = company overhead (insurance, office, phones…), not charged to a job.
  projectId       String?
  taskId          String?
  costCodeId      String?
  vendorId        String?
  vendorName      String
  amountCents     Int
  salesTaxCents   Int            @default(0)
  category        CostCategory   @default(MATERIAL)
  /// TAX_CATEGORIES id from packages/shared/src/tax.ts
  taxCategory     String         @default("job_materials")
  paidBy          PaidBy
  /// Recorded for company payments to vendors (drives 1099-NEC). null = not recorded.
  paymentMethod   PaymentMethod?
  status          ExpenseStatus  @default(SUBMITTED)
  spentOn         DateTime       @db.Date
  note            String?
  receiptFileId   String?
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
  reimbursedAt    DateTime?
  payrollExportId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user          User           @relation("ExpenseSubmitter", fields: [userId], references: [id])
  reviewedBy    User?          @relation("ExpenseReviewer", fields: [reviewedById], references: [id])
  project       Project?       @relation(fields: [projectId], references: [id])
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  costCode      CostCode?      @relation(fields: [costCodeId], references: [id])
  vendor        Vendor?        @relation(fields: [vendorId], references: [id])
  receipt       FileObject?    @relation(fields: [receiptFileId], references: [id])
  payrollExport PayrollExport? @relation(fields: [payrollExportId], references: [id])

  @@index([orgId, status])
  @@index([projectId])
  @@index([orgId, spentOn])
}

model MaterialRequest {
  id            String                @id @default(uuid())
  taskId        String
  requestedById String
  description   String
  quantity      String?
  neededBy      DateTime?             @db.Date
  status        MaterialRequestStatus @default(REQUESTED)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  task          Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy   User                  @relation(fields: [requestedById], references: [id])

  @@index([status])
}

/// Business miles in a personal or company vehicle (standard mileage rate method).
model MileageLog {
  id        String       @id @default(uuid())
  orgId     String
  userId    String
  projectId String?
  date      DateTime     @db.Date
  miles     Float
  purpose   String
  fromPlace String?
  toPlace   String?
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id])
  project   Project?     @relation(fields: [projectId], references: [id])

  @@index([orgId, date])
}

model DailyLog {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  date      DateTime @db.Date
  weather   String?
  notes     String?
  /// FileObject ids
  photoIds  String[]
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model FileObject {
  id              String             @id @default(cuid())
  orgId           String
  uploadedById    String
  storageKey      String             @unique
  contentType     String
  sizeBytes       Int
  kind            FileKind           @default(RECEIPT)
  /// Set when a photo is removed; the stored object is purged and it no longer counts against storage.
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  org             Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  expenses        Expense[]
  attachment      CommentAttachment? @relation("AttachmentFile")
  attachmentThumb CommentAttachment? @relation("AttachmentThumb")

  @@index([orgId, deletedAt])
}

// ───────────────────── Task discussions ─────────────────────

/// A note or question on a task, from the crew or the office. See docs/plans/task-discussions.md.
model TaskComment {
  /// Client-generated UUID, so a post from an offline phone is idempotent.
  id           String              @id
  orgId        String
  taskId       String
  authorId     String
  /// Plain text. Blanked when removed (the text is kept in the AuditLog).
  body         String              @default("")
  kind         CommentKind         @default(NOTE)
  /// Questions: set by the first manager/owner note after it, or "Mark answered"; cleared on reopen.
  answeredAt   DateTime?
  answeredById String?
  /// When it was written (device time for offline posts, never in the future).
  createdAt    DateTime
  /// When the server got it. Unread markers and the edit window use this.
  receivedAt   DateTime            @default(now())
  editedAt     DateTime?
  deletedAt    DateTime?
  deletedById  String?
  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task         Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author       User                @relation(fields: [authorId], references: [id])
  attachments  CommentAttachment[]

  @@index([taskId, createdAt])
  @@index([authorId, receivedAt])
  @@index([orgId, kind, answeredAt])
}

model CommentAttachment {
  /// Client-generated UUID.
  id          String      @id
  commentId   String
  fileId      String      @unique
  thumbFileId String      @unique
  width       Int
  height      Int
  position    Int
  comment     TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  file        FileObject  @relation("AttachmentFile", fields: [fileId], references: [id])
  thumb       FileObject  @relation("AttachmentThumb", fields: [thumbFileId], references: [id])

  @@index([commentId])
}

/// The last time each person read a task's discussion. Drives unread markers.
model TaskCommentRead {
  userId     String
  taskId     String
  lastReadAt DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([userId, taskId])
  @@index([taskId])
}

// ───────────────────── Checklists / walkthroughs ─────────────────────

model ChecklistTemplate {
  id           String                  @id @default(cuid())
  orgId        String
  name         String
  org          Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items        ChecklistTemplateItem[]
  walkthroughs Walkthrough[]
}

model ChecklistTemplateItem {
  id                 String            @id @default(cuid())
  templateId         String
  section            String?
  text               String
  sortOrder          Int               @default(0)
  requirePhotoOnFail Boolean           @default(true)
  template           ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Walkthrough {
  id              String                  @id @default(uuid())
  projectId       String
  templateId      String
  performedById   String
  startedAt       DateTime
  completedAt     DateTime?
  signatureFileId String?
  notes           String?
  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template        ChecklistTemplate       @relation(fields: [templateId], references: [id])
  performedBy     User                    @relation(fields: [performedById], references: [id])
  results         WalkthroughItemResult[]
}

model WalkthroughItemResult {
  id            String          @id @default(uuid())
  walkthroughId String
  /// Snapshot of the template item text at time of walkthrough.
  itemText      String
  section       String?
  result        ChecklistResult
  note          String?
  photoIds      String[]
  walkthrough   Walkthrough     @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  punchTask     Task?
}

// ───────────────────── Payroll ─────────────────────

model PayPeriod {
  id         String          @id @default(cuid())
  orgId      String
  startDate  DateTime        @db.Date
  endDate    DateTime        @db.Date
  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  timesheets Timesheet[]
  exports    PayrollExport[]

  @@unique([orgId, startDate])
}

model Timesheet {
  id                String          @id @default(cuid())
  orgId             String
  userId            String
  payPeriodId       String
  status            TimesheetStatus @default(DRAFT)
  submittedAt       DateTime?
  reviewedById      String?
  reviewedAt        DateTime?
  reviewNote        String?
  /// Computed from SHIFTS and frozen at approval.
  regularMinutes    Int?
  overtimeMinutes   Int?
  doubleTimeMinutes Int?
  /// Gross wages estimate in cents at approval (payroll provider is the system of record).
  grossCents        Int?
  /// Of the paid minutes, how many were allocated to tasks (job-costing coverage; does not affect pay).
  allocatedMinutes  Int?
  payrollExportId   String?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user          User           @relation("TimesheetOwner", fields: [userId], references: [id])
  reviewedBy    User?          @relation("TimesheetReviewer", fields: [reviewedById], references: [id])
  payPeriod     PayPeriod      @relation(fields: [payPeriodId], references: [id])
  payrollExport PayrollExport? @relation(fields: [payrollExportId], references: [id])
  entries       TimeEntry[]
  shifts        Shift[]

  @@unique([userId, payPeriodId])
  @@index([orgId, status])
}

model PayrollExport {
  id          String              @id @default(cuid())
  orgId       String
  payPeriodId String
  format      PayrollExportFormat
  createdById String
  createdAt   DateTime            @default(now())
  paidAt      DateTime?
  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  payPeriod   PayPeriod           @relation(fields: [payPeriodId], references: [id])
  timesheets  Timesheet[]
  expenses    Expense[]
}

// ───────────────────── Vendors & tax ─────────────────────

model Vendor {
  id                String          @id @default(cuid())
  orgId             String
  name              String
  isSubcontractor   Boolean         @default(false)
  is1099Eligible    Boolean         @default(false)
  w9OnFile          Boolean         @default(false)
  /// W-9 line 3. Corporations are generally exempt from 1099-NEC (attorneys are not).
  taxClassification VendorTaxClass?
  isAttorney        Boolean         @default(false)
  w9ReceivedOn      DateTime?       @db.Date
  /// AES-256-GCM ciphertext (see apps/api/src/lib/crypto.ts). Only last4 is ever shown.
  tinEncrypted      String?
  tinLast4          String?
  email             String?
  address           String?
  org               Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  workerProfiles    WorkerProfile[]

  @@index([orgId])
}

model TaxYearSettings {
  id                     String       @id @default(cuid())
  orgId                  String
  year                   Int
  /// 1099-NEC reporting threshold. $600 through 2025 payments; $2,000 for payments starting 2026 (verify annually).
  form1099ThresholdCents Int
  /// IRS standard mileage rate in tenths of a cent per mile (e.g. 700 = 70.0¢).
  mileageRateMilliCents  Int
  /// Combined effective rate (income + SE tax) agreed with the CPA, for the estimate worksheet.
  estimatedTaxRateBps    Int          @default(2500)
  /// Prior-year total tax, for the safe-harbor method.
  priorYearTaxCents      Int?
  /// Prior-year AGI over $150k → safe harbor is 110% of prior-year tax.
  priorYearAgiOver150k   Boolean      @default(false)
  org                    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, year])
}

model EstimatedTaxPayment {
  id          String       @id @default(cuid())
  orgId       String
  year        Int
  quarter     Int
  amountCents Int
  paidOn      DateTime     @db.Date
  note        String?
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, year])
}

// ───────────────────── Infrastructure ─────────────────────

model AuditLog {
  id         String       @id @default(cuid())
  orgId      String
  actorId    String?
  entityType String
  entityId   String
  action     String
  before     Json?
  after      Json?
  reason     String?
  at         DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor      User?        @relation(fields: [actorId], references: [id])

  @@index([orgId, entityType, entityId])
}

/// Dedupe table for offline outbox ops (mobile retries are idempotent on opId).
model ProcessedOp {
  opId        String   @id
  userId      String
  type        String
  status      String
  error       String?
  processedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A single-use link that adds someone to an org. Only the SHA-256 of the token is stored; the
/// raw link is shown to the inviter once (creation or regeneration).
model Invite {
  id              String                @id @default(cuid())
  orgId           String
  email           String
  name            String
  phone           String?
  role            Role
  /// For WORKER invites.
  classification  WorkerClassification?
  /// Starting pay rate; only OWNER/HR may set it.
  hourlyRateCents Int?
  tokenHash       String                @unique
  invitedById     String
  expiresAt       DateTime
  acceptedAt      DateTime?
  acceptedUserId  String?
  revokedAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  org             Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy       User                  @relation("InviteSender", fields: [invitedById], references: [id])
  acceptedUser    User?                 @relation("InviteAcceptor", fields: [acceptedUserId], references: [id])

  @@index([orgId, email])
}

/// Failed sign-in counters (per hashed email and per client IP) for rate limiting.
/// Fixed 15-minute windows; `lockedUntil` is set when a key hits its limit.
model LoginThrottle {
  /// "email:<sha256 of lowercased email>" or "ip:<address>"
  key         String    @id
  failures    Int
  windowStart DateTime
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt])
}
