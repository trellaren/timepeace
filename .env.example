# Postgres (docker compose default)
DATABASE_URL=postgresql://timepeace:timepeace@localhost:5432/timepeace
# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# File storage: "local" writes to ./.data/uploads; "s3" uses the S3_* vars (MinIO in docker compose)
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=timepeace
S3_ACCESS_KEY=timepeace
S3_SECRET_KEY=timepeace-secret
# 32-byte hex key for column-level encryption of TINs (generate: openssl rand -hex 32)
FIELD_ENCRYPTION_KEY=
# Web/mobile clients
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
