{
  "name": "timepeace",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=!@timepeace/mobile",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @timepeace/db generate",
    "db:migrate": "pnpm --filter @timepeace/db migrate",
    "db:seed": "pnpm --filter @timepeace/db seed",
    "db:reset": "pnpm --filter @timepeace/db reset",
    "mobile": "pnpm --filter @timepeace/mobile start"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "@types/node": "^22.15.0"
  }
}
